# Copia este archivo a .env y completa los valores

# Puerto del servidor
PORT=3000

# Nombre de la aplicación (aparece en el título y el PWA)
APP_NAME=Control de Asistencia

# --- Usuario administrador inicial (se crea la primera vez) ---
ADMIN_PIN=1234
ADMIN_EMAIL=admin@control.app
ADMIN_PHONE=

# --- SMTP para enviar el código de recuperación por email ---
# Ejemplo Gmail: genera una "contraseña de aplicación" en tu cuenta Google.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Control de Asistencia <no-reply@control.app>

# Nota: sin SMTP configurado, el código de recuperación se muestra en
# pantalla (modo local). La recuperación por WhatsApp genera un enlace wa.me.
